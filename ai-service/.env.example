SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

OPENAI_API_KEY=

# Optional — only needed for the Gmail integration (Phase 3). Same Client
# ID/Secret already used for Supabase's Google login provider; just needs an
# extra authorized redirect URI added (see README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FRONTEND_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000

# false for local http dev, true in production (Railway serves https)
COOKIE_SECURE=false
